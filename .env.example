# RELIEFOS configuration. Copy to `.env` for local development. Never commit real values.
# Every integration is optional: without credentials RELIEFOS runs a clearly labelled fallback and
# never fakes a live result (payments stay disabled rather than simulated).

NODE_ENV=development
PORT=8080
# Public URL of this deployment, used to build PayPal return/cancel URLs (e.g. https://reliefos.onrender.com)
PUBLIC_BASE_URL=http://localhost:5173

# PostgreSQL connection string. When unset, RELIEFOS uses embedded PGlite stored in PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Signs workspace session cookies. Required in production.
SESSION_SECRET=

# PayPal REST app credentials from https://developer.paypal.com/dashboard/applications/sandbox
# Sandbox only: RELIEFOS refuses PAYPAL_ENVIRONMENT=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_TIMEOUT_MS=15000

# Channel3 product search API key from https://trychannel3.com/developers
CHANNEL3_API_KEY=

# Anthropic API key for the Claude planner. Without it the deterministic planner runs (labelled).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# AG Studio / AG Grid Enterprise licence (trial: https://www.ag-grid.com/studio/license-pricing/).
# Without it the components render with an evaluation watermark.
AG_STUDIO_LICENSE_KEY=
AG_GRID_LICENSE_KEY=

# Render Workflows: when both are set, mission jobs run as Render Workflow tasks; otherwise in-process.
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=

LOG_LEVEL=info
