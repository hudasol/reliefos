{
  "name": "reliefos",
  "version": "0.1.0",
  "private": true,
  "description": "RELIEFOS: secure, auditable AI procurement missions for emergency relief, executed through PayPal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite --config web/vite.config.ts\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start:workflows": "node dist/server/server/workflows/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "@bryntum/scheduler-react": "7.3.7",
    "@channel3/sdk": "4.3.0",
    "@electric-sql/pglite": "0.5.10",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@renderinc/sdk": "1.2.0",
    "@tanstack/react-query": "5.104.4",
    "ag-charts-community": "14.2.0",
    "ag-charts-enterprise": "14.2.0",
    "ag-charts-react": "14.2.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-enterprise": "36.2.0",
    "ag-grid-react": "36.2.0",
    "ag-studio": "3.0.0",
    "ag-studio-react": "3.0.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
